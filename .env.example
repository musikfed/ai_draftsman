# Copy to .env; never commit secrets
DRAFTSMAN_HOST=0.0.0.0
DRAFTSMAN_PORT=9898
DRAFTSMAN_DATA=./data
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Colon-separated mount roots for model discovery

# Read-only discovery of existing model weights
DRAFTSMAN_MODEL_ROOTS=/1tbdisk:/1tb500dgmext:/1tb500dmntfs:/ssd120
